<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <Id>aee9b733-bda2-4b60-ae11-58ced13abd0e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Toxic Orca Studio</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Why Type"/>
  <Description DefaultValue="Create, organize, and search reusable email templates, then insert them into your message with one click or a keyword."/>
  <IconUrl DefaultValue="https://toxicorca.github.io/why-type-site/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://toxicorca.github.io/why-type-site/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://toxicorca.github.io/why-type-site/support.html"/>

  <AppDomains>
    <AppDomain>https://toxicorca.github.io/why-type-site</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <!-- IMPORTANT: FormSettings must appear before Permissions in this schema -->
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://toxicorca.github.io/why-type-site/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- ✅ ONLY VersionOverrides. NO ExtendedOverrides. -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="WhyType.Group">
                <Label resid="WhyTypeGroup.Label"/>

                <!-- Button 1: Opens task pane -->
                <Control xsi:type="Button" id="WhyType.OpenPane">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://toxicorca.github.io/why-type-site/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://toxicorca.github.io/why-type-site/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://toxicorca.github.io/why-type-site/assets/icon-80.png"/>
      </bt:Images>

      <bt:Urls>
        <bt:Url id="Taskpane.Url"  DefaultValue="https://toxicorca.github.io/why-type-site/taskpane.html"/>
      </bt:Urls>

      <bt:ShortStrings>
        <bt:String id="WhyTypeGroup.Label" DefaultValue="Why Type"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Why Type"/>
      </bt:ShortStrings>

      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open the Why Type quick text panel."/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
